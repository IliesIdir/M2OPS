#!/usr/bin/env bash
# Lance l'environnement de développement : crée ou complète .env, puis démarre docker compose.
set -euo pipefail
cd "$(dirname "$0")/.."

if [ ! -f .env ]; then
    cp .env.example .env
    # On génère un mot de passe aléatoire pour ne jamais avoir de secret par défaut dans le dépôt.
    mot_de_passe=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
    sed -i "s/^POSTGRES_PASSWORD=.*/POSTGRES_PASSWORD=${mot_de_passe}/" .env
    echo "Fichier .env cree a partir de .env.example"
fi

# Un .env créé avant l'ajout d'une variable reçoit cette variable avec sa valeur d'exemple.
grep -E '^[A-Z_]+=' .env.example | while IFS= read -r ligne; do
    variable="${ligne%%=*}"
    if ! grep -q "^${variable}=" .env; then
        echo "$ligne" >> .env
        echo "Variable ajoutee a .env : ${variable}"
    fi
done

# Le dossier du stockage brut est créé ici pour qu'il appartienne à l'utilisateur et non à root.
mkdir -p articles_bruts

docker compose up --build --detach --remove-orphans "$@"
docker compose ps
