# Variables lues par docker-compose.yml. bin/dev copie ce fichier en .env s'il n'existe pas
# et génère un mot de passe aléatoire. Ne jamais commiter .env.

# Base PostgreSQL de la gazette, et base séparée pour l'historique de Dagster
POSTGRES_USER=gazette
POSTGRES_DB=gazette
DAGSTER_DB=dagster
POSTGRES_PASSWORD=

# Port local de l'interface Dagster (http://localhost:3000)
DAGSTER_PORT=3000

# Webhook Discord du canal d'alertes de l'équipe (vide : les alertes restent dans les journaux)
DISCORD_WEBHOOK_URL=
